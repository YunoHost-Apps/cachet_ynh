#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

timezone=$(timedatectl show --value --property=Timezone)

#=================================================
# SET MAINTENANCE MODE ON
#=================================================

_ynh_artisan "down"

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

# Download, check integrity, uncompress and patch the source from manifest.toml
ynh_setup_source --dest_dir="$install_dir" --full_replace --keep=".env bootstrap/cachet/production.php"

chown -R "$app:www-data" "${install_dir}/.env" "${install_dir}/storage/" "${install_dir}/bootstrap/"

#=================================================
# REAPPLY SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_nginx

ynh_config_add_phpfpm

ynh_config_add --template="cron" --destination="/etc/cron.d/$app"

#=================================================
# INSTALL AND INITIALIZE COMPOSER
#=================================================
ynh_script_progression "Upgrading Cachet configuration and dependencies..."

ynh_composer_exec install --no-dev --optimize-autoloader
ynh_composer_exec update cachethq/core

#=================================================
# UPDATE CACHET CONFIGURATION
#=================================================

pushd $install_dir
	_ynh_artisan vendor:publish --tag=cachet
	_ynh_artisan migrate --force
	_ynh_artisan queue:work --stop-when-empty
popd

#=================================================
# SET MAINTENANCE MODE OFF
#=================================================

_ynh_artisan "up"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
