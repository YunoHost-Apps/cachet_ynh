APP_NAME=Cachet
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://__DOMAIN____PATH__
APP_TIMEZONE=UTC
DEBUGBAR_ENABLED=false

APP_LOCALE=__LANGUAGE__
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

DB_DRIVER=mysql
DB_HOST=localhost
DB_UNIX_SOCKET=null
DB_DATABASE=__DB_NAME__
DB_USERNAME=__DB_USER__
DB_PASSWORD=__DB_PWD__
DB_PORT=null
DB_PREFIX=null

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

CACHET_BEACON=false
CACHET_EMOJI=false
CACHET_AUTO_TWITTER=true

MAIL_DRIVER=sendmail
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=__APP__
MAIL_PASSWORD=__MAIL_PWD__
MAIL_ADDRESS=__ADMIN_MAIL__
MAIL_NAME=__ADMIN__
MAIL_ENCRYPTION=tls

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

GITHUB_TOKEN=null

NEXMO_KEY=null
NEXMO_SECRET=null
NEXMO_SMS_FROM=Cachet

TRUSTED_PROXIES=
